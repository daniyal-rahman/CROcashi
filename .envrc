# --- load key=val from .env if present ---
dotenv_if_exists .env

# --- neutralize any active conda env in this dir ---
if [[ -n "${CONDA_PREFIX:-}" ]]; then
  path_rm PATH "$CONDA_PREFIX/bin"
  unset CONDA_PREFIX CONDA_DEFAULT_ENV CONDA_SHLVL CONDA_PROMPT_MODIFIER _CE_CONDA _CE_M
fi

# --- activate local venv if present, else create a direnv-managed one ---
if [[ -d .venv ]]; then
  export VIRTUAL_ENV="$(pwd)/.venv"
  PATH_add "$VIRTUAL_ENV/bin"
else
  layout python3   # creates/uses .direnv/python-<ver>/
fi

# keep Python from mixing in user site-packages
export PYTHONNOUSERSITE=1

